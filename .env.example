# Flask
FLASK_APP=wsgi.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-in-production
# 5000 is taken by AirPlay Receiver on macOS, so 5001 is the default here
APP_PORT=5001

# MySQL (consumed both by the API container and by the MySQL container)
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=ecommerce
MYSQL_USER=ecommerce
MYSQL_PASSWORD=ecommerce
MYSQL_ROOT_PASSWORD=root
MYSQL_EXTERNAL_PORT=3307

# phpMyAdmin
PMA_PORT=8080

# Pagination defaults
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
